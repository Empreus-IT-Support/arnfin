# Copy to .env.local for local dev, and set the same vars in Vercel.
# With no RESEND_API_KEY the forms still "succeed" for the visitor and the
# submission is logged server-side, so the site is safe to deploy before DNS
# verification is finished.

# Resend API key — https://resend.com → API Keys
RESEND_API_KEY=

# Verified sender. The domain must be verified in Resend via DNS records.
CONTACT_FROM="Arnold & Finlay Website <website@arnfin.net.au>"

# Where enquiries are delivered.
CONTACT_RECIPIENT=arnold.finlay@arnfin.net.au

# Optional — Resend → Audiences → (your audience) → ID.
# When set, newsletter signups are added to this audience.
# When empty, signups are emailed to CONTACT_RECIPIENT instead.
RESEND_AUDIENCE_ID=
